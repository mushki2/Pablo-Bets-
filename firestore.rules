rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public Ledger for Transparency ---
    // All authenticated users can read the public ledger of bets.
    // Writes are disallowed from the client to ensure integrity; only the backend can log results.
    match /PublicLedger/{betId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- User Profiles (Public-Facing) ---
    // Public profiles with non-sensitive data like ROI, win streaks, and display names.
    // Anyone can read, but only the user themselves can create or update their own profile.
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Prevent users from deleting their public profiles.
    }

    // --- User Private Data (Strictly Private) ---
    // Contains sensitive information like wallet details, balances, and transaction history.
    // Only the authenticated user can access their own private data document.
    match /users/{userId} {
      allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- Group Betting Pools ---
    // Users can read the details of a betting pool.
    // Creating a new pool is allowed for any authenticated user.
    // Updating a pool (e.g., to add a participant) should be handled by backend logic via a dedicated endpoint,
    // but for now, we will allow authenticated users to update. This should be tightened later.
    match /pools/{poolId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // To be refined with more specific rules or backend logic.
      allow delete: if false;
    }

    // Default deny all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
