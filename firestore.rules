rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The "PublicLedger" collection is read-only for all authenticated users.
    // No one can write to it directly; only the server-side logic (our Python function) can.
    match /PublicLedger/{betId} {
      allow read: if request.auth != null;
      allow write: if false; // Disallow all client-side writes
    }

    // "Users" collection stores user-specific data.
    // Users can only read and write their own data.
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // "Profiles" collection could store public-facing user info (leaderboard stats).
    // Allow any authenticated user to read, but only the user themselves can create or update their profile.
    match /Profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Prevent users from deleting their profiles
    }

    // This is a catch-all rule that denies access to any other collections
    // that are not explicitly defined above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
