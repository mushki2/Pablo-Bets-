# === BACKEND SECRETS (Python API) ===
# These variables are used by the Python serverless function and should be kept private.
# Do not expose them to the frontend.

# Telegram Bot API Token from BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# The chat ID where the bot will send alerts
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Your API key from The Odds API
ODDS_API_KEY="YOUR_ODDS_API_KEY"

# The full JSON content of your Firebase service account key for the backend.
# It should be a single line string. You can get this from your Firebase project settings.
# Example: '{"type": "service_account", "project_id": "...", ...}'
FIREBASE_SERVICE_ACCOUNT='YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_CONTENT'


# === FRONTEND PUBLIC KEYS (Next.js App) ===
# These variables are safe to be exposed to the browser.
# They are prefixed with NEXT_PUBLIC_ to be loaded by the Next.js application.
# You can find these values in your Firebase project settings under "General".

NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_CLIENT_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_CLIENT_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_CLIENT_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_CLIENT_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_CLIENT_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_CLIENT_APP_ID"
